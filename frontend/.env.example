# ============================================
# Spotter Frontend Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git (it's in .gitignore)

# ============================================
# REQUIRED: Supabase Configuration
# ============================================
# Get these from your Supabase project: Settings > API
# - URL: Your project URL (e.g., https://xxxxx.supabase.co)
# - Publishable Key: Safe for client-side use (starts with sb_publishable_)

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# ============================================
# OPTIONAL: RevenueCat Configuration
# ============================================
# For in-app purchases and subscription management
# Get these from RevenueCat dashboard: Project Settings > API Keys
# You can use platform-specific keys OR a single key for both platforms

# Option 1: Platform-specific keys (recommended)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your_ios_api_key_here
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your_android_api_key_here

# Option 2: Single key for both platforms (fallback)
# EXPO_PUBLIC_REVENUECAT_API_KEY=your_universal_api_key_here

# ============================================
# OPTIONAL: Error Monitoring (Sentry)
# ============================================
# For production error tracking and crash reporting
# Get DSN from Sentry project: Settings > Client Keys (DSN)

EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# ============================================
# Notes
# ============================================
# - All EXPO_PUBLIC_* variables are exposed to the client bundle
# - Never put secrets in EXPO_PUBLIC_* variables
# - For secrets, use Expo SecureStore or server-side only
# - .env.local is gitignored and should never be committed
