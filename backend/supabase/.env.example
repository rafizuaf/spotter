# ============================================
# Spotter Backend Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git (it's in .gitignore)

# ============================================
# REQUIRED: Supabase Configuration
# ============================================
# Get these from your Supabase project: Settings > API
# - URL: Your project URL (e.g., https://xxxxx.supabase.co)
# - Publishable Key: Safe for client-side use (starts with sb_publishable_)
# - Secret Key: Server-side only, bypasses RLS (starts with sb_secret_)
#   ⚠️ NEVER expose this key to the client!

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# ============================================
# REQUIRED: Database Password
# ============================================
# Your Supabase database password
# Set during project creation or reset in: Settings > Database

DB_PASS=your_database_password_here

# ============================================
# OPTIONAL: CORS Configuration
# ============================================
# Frontend URL for CORS headers in edge functions
# Defaults to "https://spotter-app.com" if not set
# Set this to your production frontend URL

FRONTEND_URL=https://spotter-app.com

# ============================================
# OPTIONAL: RevenueCat Webhook Secret
# ============================================
# Required for payment-webhook edge function
# Get from RevenueCat: Project Settings > Webhooks > Webhook Secret
# Used to validate webhook requests from RevenueCat

REVENUECAT_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# OPTIONAL: Internal Service Key
# ============================================
# For internal service-to-service communication
# Used by compute-leaderboards and send-push-notification
# Can use SUPABASE_SERVICE_ROLE_KEY as fallback

INTERNAL_SERVICE_KEY=your_internal_service_key_here

# ============================================
# OPTIONAL: Supabase Auth Providers
# ============================================
# Only needed if you enable these features in config.toml

# Twilio SMS (if SMS auth is enabled)
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Apple OAuth (if Apple sign-in is enabled)
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=your_apple_secret

# OpenAI API (if using OpenAI features)
# OPENAI_API_KEY=your_openai_api_key

# ============================================
# OPTIONAL: Supabase Storage (S3)
# ============================================
# Only needed if using S3 for storage backend

# S3_HOST=your_bucket.s3-region.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# ============================================
# OPTIONAL: Supabase Auth Providers
# ============================================
# Only needed if you enable these features in config.toml

# Twilio SMS (if SMS auth is enabled)
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Apple OAuth (if Apple sign-in is enabled)
# SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=your_apple_secret

# OpenAI API (if using OpenAI features)
# OPENAI_API_KEY=your_openai_api_key

# ============================================
# OPTIONAL: Supabase Storage (S3)
# ============================================
# Only needed if using S3 for storage backend

# S3_HOST=your_bucket.s3-region.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# ============================================
# Auto-Injected by Supabase (Do Not Set Manually)
# ============================================
# These are automatically injected by Supabase Edge Functions runtime:
# - SUPABASE_SERVICE_ROLE_KEY: Service role key for admin operations
# - SUPABASE_ANON_KEY: Anonymous key (same as publishable key)
# 
# You can override them here if needed, but it's not recommended.

# ============================================
# Notes
# ============================================
# - SUPABASE_SECRET_KEY and DB_PASS are sensitive - never commit them
# - Edge functions automatically have access to SUPABASE_URL and keys
# - FRONTEND_URL is used for CORS - set to your production domain
# - .env.local is gitignored and should never be committed
# - Optional variables are only needed if you enable those features
# - Optional variables are only needed if you enable those features
